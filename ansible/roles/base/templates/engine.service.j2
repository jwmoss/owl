[Unit]
Description={{ base_engine_description }}
# Conflicts= does not wait for the other engine to stop, so the new one could find the port in use.
# An order (one way only, by the engines list) makes systemd finish the stop first.
After=network-online.target halogen-fabric-clock.service{% for e in engines[:engines.index(base_engine)] %} {{ e }}.service{% endfor %}

Wants=network-online.target
Conflicts={{ engines | reject('equalto', base_engine) | map('regex_replace', '$', '.service') | join(' ') }}
OnFailure=owl-fallback@%n.service
StartLimitIntervalSec=900
StartLimitBurst=4

[Service]
User={{ ansible_user }}
ExecStartPre=/usr/local/bin/owl-wait-memory
Restart=on-failure
RestartSec=30
{{ base_engine_service }}
[Install]
WantedBy=multi-user.target
